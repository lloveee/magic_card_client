.login__background {
    background-image: url("project://database/Assets/CoreDomain/GameDomain/GameStateDomain/GameProfileDomain/Assets/UI/Art/holofront.png?fileID=2800000&guid=d2da341dba7352f4287e8f812959f32f&type=3#holofront");
}

.login__content {
    position: absolute;
    background-color: rgb(176, 176, 176);
    width: 50%;
    height: 40%;
    left: 25%;
    top: 30%;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-color: rgba(53, 53, 53, 0.64);
    border-right-color: rgba(53, 53, 53, 0.64);
    border-top-color: rgba(53, 53, 53, 0.64);
    border-bottom-color: rgba(53, 53, 53, 0.64);
    border-bottom-width: 5px;
    border-right-width: 5px;
    justify-content: center;
    align-self: center;
    align-content: stretch;
}

.login__userbar {
    width: 70%;
    align-items: stretch;
    align-self: center;
    margin-bottom: 20px;
}

.login__pwdbar {
    width: 70%;
    align-self: center;
    margin-bottom: 20px;
}

.login__button {
    justify-content: center;
    width: 70%;
    align-self: center;
    align-content: auto;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    translate: 0 100%;
}
