.init__background {
    background-color: rgb(0, 0, 0);
    position: relative;
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: auto;
    align-self: auto;
    justify-content: flex-start;
    align-items: stretch;
    height: 100%;
    flex-wrap: nowrap;
    flex-direction: column;
    width: 100%;
}

.init__content {
    background-color: rgb(205, 205, 205);
    width: 46%;
    height: 30%;
    justify-content: space-between;
    align-self: center;
    align-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    bottom: auto;
    top: 35%;
    border-top-width: 5px;
    border-top-color: rgba(255, 255, 255, 0.53);
    position: absolute;
    border-right-width: 5px;
    border-right-color: rgba(255, 255, 255, 0.4);
    border-bottom-width: 5px;
    border-bottom-color: rgba(255, 255, 255, 0.31);
    border-left-width: 5px;
    border-left-color: rgba(255, 255, 255, 0.47);
}

.init__button {
    font-size: 25px;
    width: 36%;
}

.init__nickname {
    font-size: 80px;
    -unity-text-align: upper-center;
    text-shadow: 3.1px 0 0 rgb(90, 90, 90);
    -unity-text-outline-width: 1px;
}
