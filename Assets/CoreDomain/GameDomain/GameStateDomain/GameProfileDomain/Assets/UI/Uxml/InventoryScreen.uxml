<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/CoreDomain/GameDomain/GameStateDomain/GameProfileDomain/Assets/UI/Uss/InventoryScreen.uss?fileID=7433441132597879392&amp;guid=0f72a418a5c3daa4895cce604ff9bc89&amp;type=3#InventoryScreen" />
    <ui:VisualElement name="inventory__container" picking-mode="Ignore" class="inventory__container" style="flex-grow: 1; flex-basis: 90%;">
        <ui:VisualElement name="inventory__view" picking-mode="Ignore" class="inventory__view" style="flex-grow: 1; display: flex;">
            <ui:ScrollView horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" mode="Horizontal" name="inventory__view_container" class="inventory__view_container" style="width: 100%; height: 100%; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; align-self: stretch; align-items: stretch; justify-content: space-between; align-content: stretch;" />
        </ui:VisualElement>
        <ui:VisualElement name="inventory__panel" picking-mode="Ignore" class="inventory__panel" style="display: flex;">
            <ui:VisualElement name="inventory__panel_header" class="inventory__panel_header" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/CoreDomain/Assets/UI/UI_atlas.psd?fileID=-2112341285&amp;guid=fb8c91bd35b751b4a82920a57cd88822&amp;type=3#UI_atlas_105&quot;);">
                <ui:Label text="Label" name="inventory__panel_header_text" class="inventory__panel_header_text" />
            </ui:VisualElement>
            <ui:VisualElement name="inventory__panel__body" class="inventory__panel__body" style="flex-grow: 1;">
                <ui:Button text="Set Active" name="inventory__panel_set_btn" class="inventory__panel_set_btn" />
                <ui:ScrollView picking-mode="Ignore" mode="Vertical" horizontal-scroller-visibility="Hidden" name="inventory__panel__info_container" class="inventory__panel__info_container" style="top: 20px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="inventory__home_background" picking-mode="Ignore" class="inventory__home_background" style="flex-grow: 1; display: none;">
        <ui:VisualElement name="inventory__navigation_bar" picking-mode="Ignore" style="flex-grow: 1; flex-basis: 10%; display: none;" />
    </ui:VisualElement>
</ui:UXML>
