.inventory__home_background {
    position: absolute;
    width: 100%;
    height: 100%;
}

.inventory__container {
    flex-direction: row;
}

.inventory__view {
    flex-basis: 75%;
    background-color: rgb(0, 0, 0);
    flex-grow: 1;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-sine;
    display: flex;
}

.inventory__panel {
    flex-basis: 25%;
    flex-grow: 1;
    flex-shrink: 1;
    background-color: rgb(247, 66, 66);
    display: flex;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-sine;
    visibility: visible;
    opacity: 1;
    transition-property: all;
}
