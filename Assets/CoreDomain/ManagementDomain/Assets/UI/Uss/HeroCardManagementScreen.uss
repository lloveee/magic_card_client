.hero_card__container {
    width: 100%;
    height: 100%;
    position: absolute;
}

.parent__navigation_bar {
    width: 100%;
    height: 10%;
    flex-shrink: 1;
    flex-grow: 1;
    flex-basis: 10%;
    position: absolute;
}

.hero_card_management__container {
    position: absolute;
    width: 100%;
    height: 90%;
    flex-direction: column;
    top: 10%;
}

.hero_card_pre__list {
    position: absolute;
    width: 75%;
    height: 100%;
    left: 0%;
    top: 0%;
    background-color: rgba(249, 249, 249, 0);
    background-image: url("project://database/Assets/CoreDomain/Assets/UI/UI_atlas.psd?fileID=-252670299&guid=fb8c91bd35b751b4a82920a57cd88822&type=3#UI_atlas_109");
}

.hero_card_pre__panel {
    position: absolute;
    width: 25%;
    height: 100%;
    left: 75%;
    top: 0%;
    background-color: rgba(255, 255, 255, 0);
    border-left-width: 0;
    border-left-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    background-image: url("project://database/Assets/CoreDomain/Assets/UI/UI_atlas.psd?fileID=105505938&guid=fb8c91bd35b751b4a82920a57cd88822&type=3#UI_atlas_98");
}

.unity-scroll-view__content-container {
    flex-direction: column;
    flex-wrap: wrap;
    align-self: auto;
}

.hero_card_pre__edit_list {
    position: absolute;
    width: 100%;
    height: 100%;
    align-self: center;
    align-content: stretch;
}

.hero_card_pre__edit_attr {
    font-size: 24px;
}

.hero_card_pre__edit_attr > .unity-label {
    -unity-text-align: middle-center;
}

.hero_card__upload {
    position: absolute;
    right: 0%;
    height: 100%;
    width: 10%;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 0%;
    padding-top: 0%;
    padding-right: 0%;
    padding-bottom: 0%;
    padding-left: 0%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 28px;
    background-image: url("project://database/Assets/CoreDomain/Assets/UI/UI_atlas.psd?fileID=-128483938&guid=fb8c91bd35b751b4a82920a57cd88822&type=3#UI_atlas_99");
}

.hero_card__re_upload {
    position: absolute;
    right: 11%;
    height: 100%;
    width: 10%;
    font-size: 26px;
    background-image: url("project://database/Assets/CoreDomain/Assets/UI/UI_atlas.psd?fileID=-128483938&guid=fb8c91bd35b751b4a82920a57cd88822&type=3#UI_atlas_99");
}
